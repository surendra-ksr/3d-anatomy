# ---------------------------------------------------------------------------
# Interactive Anatomy Engine - environment
# Copy to .env (or let scripts/dev.sh export defaults) and adjust.
# ---------------------------------------------------------------------------

# PostgreSQL (scripts/dev_db.py boots a local server on this port)
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/anatomy

# FastAPI data service (proxied by Next.js under /api/py/*)
FASTAPI_URL=http://127.0.0.1:8000

# Production: object storage base for mesh assets (leave empty in dev -
# GLBs are served from /public/models)
# MESH_ASSET_BASE_URL=https://cdn.example.com/anatomy
# NEXT_PUBLIC_ASSET_BASE_URL=https://cdn.example.com/anatomy
