{
  "name": "anatomy-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive Anatomy Engine — BodyParts3D meshes mapped to the FMA ontology, served via Next.js + FastAPI + PostgreSQL (Prisma).",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:seed": "tsx prisma/seed.ts",
    "pipeline": "python3 pipeline/run_pipeline.py",
    "backend": "cd backend && uvicorn main:app --host 0.0.0.0 --port 8000",
    "verify:meshes": "node scripts/verify_meshes.mjs",
    "db:init": "python3 scripts/db_init.py"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.16.2",
    "@prisma/client": "^6.16.2",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "next": "^15.5.4",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "draco3dgltf": "^1.5.7",
    "gltf-pipeline": "^4.3.0",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
