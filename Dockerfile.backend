# ---------------------------------------------------------------------------
# Interactive Anatomy Engine — FastAPI data/analytics service
#
# Validates the internal HS256 bearer token minted by the Next.js middleware
# (AUTH_INTERNAL_SECRET) and serves anatomy, symptom, analytics and clinical
# PDF data from PostgreSQL.
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install -r requirements.txt

# pipeline package (metabolic / analytics / report models) + service
COPY pipeline/anatomy_pipeline ./anatomy_pipeline
COPY backend ./backend
COPY prisma/sql/schema.sql ./prisma/sql/schema.sql

# matplotlib font cache (built once, at image build time)
RUN python3 -c "import matplotlib; matplotlib.use('Agg'); import matplotlib.pyplot" \
    && python3 -c "from reportlab.pdfgen.canvas import Canvas; import io; c=Canvas(io.BytesIO()); c.save()"

# non-root runtime user
RUN useradd --system --uid 1001 apiuser && chown -R apiuser /app
USER apiuser

ENV PYTHONPATH=/app \
    DATABASE_URL=postgresql://postgres@db:5432/anatomy \
    AUTH_INTERNAL_SECRET=change-me \
    NODE_ENV=production

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health')" || exit 1

WORKDIR /app/backend
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
