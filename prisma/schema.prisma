// ---------------------------------------------------------------------------
// Interactive Anatomy Engine - database schema
//
// Stores the anatomical hierarchy imported from the BodyParts3D (DBCLS)
// distribution mapped onto the Foundational Model of Anatomy (FMA) ontology:
//
//   AnatomicalSystem  e.g. Cardiovascular System  (FMA7161)
//        └─ Organ          e.g. Heart (FMA7088)
//             └─ Organ     e.g. Right ventricle (FMA7098)
//                  └─ Organ  e.g. Tricuspid valve (FMA7234)  [has mesh]
//                       └─ MeshAsset  Draco-compressed .glb + node path
//
// The Rust-free Prisma setup (engineType = "client") runs the query compiler
// as WASM and talks to PostgreSQL through the `pg` driver adapter, so no
// native engine binary is required.
// ---------------------------------------------------------------------------

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One of the classic anatomical systems (skeletal, circulatory, ...).
model AnatomicalSystem {
  id        Int      @id @default(autoincrement())
  /// FMA concept id of the system, e.g. "FMA7161" (cardiovascular system).
  fmaId     String   @unique
  /// Stable slug used by the frontend, e.g. "circulatory".
  key       String   @unique
  name      String
  /// Base color (hex) used for system tinting in the UI.
  color     String   @default("#888888")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  organs Organ[]

  @@map("anatomical_systems")
}

/// An anatomical structure. Organs form a containment forest
/// (left ventricle -> heart -> cardiovascular system). Organs may exist
/// without a mesh when they are pure taxonomy nodes (e.g. "Heart" itself,
/// whose geometry in BodyParts3D 3.0 lives in "Wall of heart").
model Organ {
  id         Int        @id @default(autoincrement())
  /// FMA concept id, e.g. "FMA7274". BP3D-original ids ("BPnnn", "xxxnsn")
  /// are preserved in bp3dId / on the MeshAsset.
  fmaId      String     @unique
  /// Native BodyParts3D model id when it differs from the FMA concept id.
  bp3dId     String?
  name       String
  laterality Laterality @default(MIDLINE)
  systemId   Int
  system     AnatomicalSystem @relation(fields: [systemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Containment parent (conventional part-of relation from BP3D).
  parentId   Int?
  parent     Organ?     @relation("OrganHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children   Organ[]    @relation("OrganHierarchy")

  mesh MeshAsset?

  createdAt DateTime @default(now())

  @@index([systemId])
  @@index([parentId])
  @@map("organs")
}

/// A Draco-compressed glTF asset. BodyParts3D parts are packed one .glb per
/// delivery group (e.g. "circulatory.glb"); `nodePath` addresses the part's
/// node inside that GLB. `url` is relative in development (/models/...) and
/// an absolute S3/CDN URL in production (set MESH_ASSET_BASE_URL).
model MeshAsset {
  id            Int    @id @default(autoincrement())
  organId       Int    @unique
  organ         Organ  @relation(fields: [organId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  url           String
  /// Name of the glTF node inside the GLB (the BP3D part id).
  nodePath      String
  /// Delivery group key ("skull", "circulatory", ...).
  groupKey      String
  format        String @default("glb")
  compression   String @default("draco")
  /// Size of the containing GLB artifact in bytes (parts share one GLB).
  byteSize      Int
  vertexCount   Int
  triangleCount Int
  sourceDataset String @default("BodyParts3D 3.0")
  /// Original BP3D STL file name and checksum for provenance.
  sourceFile    String
  sourceSha256  String

  createdAt DateTime @default(now())

  @@index([groupKey])
  @@map("mesh_assets")
}

/// A local profile. The MVP ships single-user (self-tracking) semantics:
/// the API resolves/creates the default profile by name (see
/// ANATOMY_DEFAULT_USER). Swap for real auth in a multi-user deployment.
model User {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  createdAt    DateTime      @default(now())
  symptomLogs  SymptomLog[]
  activityLogs ActivityLog[]

  @@map("users")
}

/// One painted pain rating for one anatomical structure on one day.
/// Re-painting the same structure the same day upserts (timestamp moves).
model SymptomLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// FMA concept id of the painted structure, e.g. "FMA13377".
  fmaId     String
  /// Clinical pain rating, 1 (minimal) - 10 (worst imaginable).
  intensity Int
  note      String?
  /// UTC midnight of the log day - the upsert key for "today's pain map".
  logDate   DateTime @db.Date
  /// Last update for this rating.
  timestamp DateTime @default(now()) @updatedAt

  @@unique([userId, fmaId, logDate])
  @@index([userId, timestamp])
  @@map("symptom_logs")
}

/// One saved Energy-Drain estimate (an activity the user planned/performed),
/// produced by the pacing estimator. The dashboard joins this with SymptomLog
/// per day to expose the delayed exertion -> pain pattern (PEM).
model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// FMA ids of the activated muscle groups, e.g. ["FMA22428","FMA9626"].
  fmaIds      String[]
  /// Duration of the activity in minutes.
  minutes     Int
  /// Pacing severity assumed by the model: mild | moderate | severe.
  severity    String
  /// Energy Drain score (0-100) from /api/metabolic-cost.
  energyDrain Float
  /// Absolute muscle metabolic cost (kcal) from /api/metabolic-cost.
  totalKcal   Float
  /// UTC midnight of the activity day - the daily aggregation key.
  logDate     DateTime @db.Date
  createdAt   DateTime @default(now())

  @@index([userId, logDate])
  @@map("activity_logs")
}

enum Laterality {
  LEFT
  RIGHT
  MIDLINE
  PAIRED
}
